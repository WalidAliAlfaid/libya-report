    "build:android": "npm run build && npx cap sync && cmd /c \"cd android && gradlew.bat assembleDebug\" && powershell -Command \"New-Item -ItemType Directory -Force -Path 'apks'; Copy-Item -Path 'android/app/build/outputs/apk/debug/app-debug.apk' -Destination ('apks/app-' + (Get-Date -Format 'yyyyMMdd_HHmmss') + '.apk')\""
  },
